# Supabase → Project Settings → Database → Connection string → "Session pooler" (URI).
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# IBKR → Performance & Reports → Flex Queries → Flex Web Service Configuration (token)
IBKR_FLEX_TOKEN=
# Activity Flex Query ID (yours is 1680034 — "TradeLedger Activity")
IBKR_FLEX_QUERY_ID=1680034


# Your IBKR account base currency (used for the "Base" currency view)
BASE_CURRENCY=EUR
# Timezone of the times in IBKR Flex reports (IBKR default is US Eastern)
FLEX_TIMEZONE=America/New_York
# Show currency-conversion (forex) fills as trades? Usually not.
INCLUDE_FOREX=false

# Login (Supabase Auth). Supabase → Project Settings → API Keys → "Publishable key" (or the legacy "anon" key).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Email(s) allowed to sign in, comma-separated. Create this user in Supabase → Authentication → Users → Add user.
ALLOWED_EMAILS=

# AI coach (optional). console.anthropic.com → API Keys. Set a monthly spend limit there too.
ANTHROPIC_API_KEY=
# Hard monthly cap the app enforces itself (USD)
AI_MONTHLY_LIMIT_USD=5
